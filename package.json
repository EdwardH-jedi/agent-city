{
	"name": "agent-city",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "bun --filter '@agent-city/hub' --filter '@agent-city/web' dev",
		"dev:hub": "bun --watch apps/hub/src/index.ts",
		"dev:web": "bun --filter '@agent-city/web' dev",
		"test": "bun test",
		"test:unit": "bun test packages apps/web/src scripts",
		"test:integration": "bun test apps/hub apps/collector",
		"test:lifecycle": "bun test apps/hub/src/managed/hardening.test.ts apps/hub/src/managed/recovery.test.ts apps/hub/src/managed/provider-hardening.test.ts",
		"build:web": "bun --filter '@agent-city/web' build",
		"verify": "bun run lint && bun run typecheck && bun test && bun run check:secrets && bun run build:web && bun run managed:demo && bun run test:browser",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p packages/schema && tsc --noEmit -p apps/hub && tsc --noEmit -p apps/collector && tsc --noEmit -p apps/web && tsc --noEmit -p apps/web/e2e",
		"format": "biome format --write .",
		"sync:github": "bun apps/hub/src/github/sync.ts",
		"db:reset": "bun apps/hub/src/db-reset.ts",
		"districts:draft": "bun apps/hub/src/github/districts-draft.ts",
		"collector:codex": "bun --no-env-file apps/collector/src/codex-tail.ts",
		"collector:hooks": "bun --no-env-file apps/collector/src/install-hooks.ts",
		"test:browser": "bun apps/web/e2e/browser-gate.ts",
		"managed:demo": "bun --no-env-file apps/hub/src/managed/demo.ts",
		"managed:preflight": "bun apps/hub/src/managed/preflight-cli.ts",
		"check:secrets": "bun scripts/check-secrets.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/bun": "1.4.2",
		"playwright-core": "1.63.0",
		"typescript": "7.0.2"
	}
}
