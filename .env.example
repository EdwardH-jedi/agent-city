# Copy to .env and fill in secrets yourself. Never commit .env.
# 토큰은 .env 에 직접 입력한다. 이 파일에는 실제 값을 넣지 않는다.

# GitHub fine-grained PAT, read-only (Contents/Metadata: read). Empty → falls back to `gh auth token`.
GITHUB_TOKEN=
# GitHub login whose repos are synced
GITHUB_LOGIN=EdwardH-jedi

# Hub bind address (keep loopback unless you know why)
HUB_HOST=127.0.0.1
# Hub port
HUB_PORT=4317
# URL collectors / web use to reach the hub
HUB_URL=http://127.0.0.1:4317
# Shared secret for collector → hub ingest (generate a long random string)
INGEST_TOKEN=

# SQLite database path (relative to repo root)
DB_PATH=./data/agentcity.db
# This machine's role: cockpit | forge | spine
AGENTCITY_MACHINE=cockpit
# Comma-separated roots scanned for local repo checkouts
REPO_ROOTS=~/Desktop/github-repo-only
# GitHub sync interval in minutes
GITHUB_SYNC_INTERVAL_MIN=10
