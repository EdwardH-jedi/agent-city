# Copy to .env and fill in secrets yourself. Never commit .env.
# 토큰은 .env 에 직접 입력한다. 이 파일에는 실제 값을 넣지 않는다.
# Every variable the code reads is listed here and in README → Environment (kept 1:1 by a test).

# ── hub ──────────────────────────────────────────────────────────────────────
# GitHub fine-grained PAT, read-only (Contents/Metadata: read). Empty → falls back to `gh auth token`.
GITHUB_TOKEN=
# GitHub login whose repos are synced
GITHUB_LOGIN=EdwardH-jedi

# Hub bind address (keep loopback unless you know why)
HUB_HOST=127.0.0.1
# Hub port
HUB_PORT=4317
# Extra browser origins allowed for CORS and /ws (comma-separated, exact). 127.0.0.1/localhost on
# any port are always allowed; only needed for a Vite dev server on another host.
HUB_ALLOWED_ORIGINS=
# URL collectors / web use to reach the hub
HUB_URL=http://127.0.0.1:4317
# Shared secret for collector → hub ingest (generate a long random string)
INGEST_TOKEN=

# SQLite database path (relative to repo root)
DB_PATH=./data/agentcity.db
# This machine's role: cockpit | forge | spine
AGENTCITY_MACHINE=cockpit
# Comma-separated roots scanned for local repo checkouts
REPO_ROOTS=~/Desktop/github-repo-only
# GitHub sync interval in minutes (0 = hub never syncs; use `bun run sync:github`)
GITHUB_SYNC_INTERVAL_MIN=10
# Stop a sync when a GitHub rate-limit bucket drops below this many requests
GITHUB_RATE_MIN=200

# ── collectors (read from this checkout's .env; process env wins) ────────────
# Spool / offsets / debug log dir. Empty → ~/.agentcity
AGENTCITY_HOME=
# 1 → ~/.agentcity/hook.log with timings + error messages (never payloads). Empty → off
AGENTCITY_DEBUG=
# Spool size cap in MB across spool.jsonl + spool.*.flushing (oldest dropped first). Empty → 20
SPOOL_MAX_MB=
# Spooled events older than this many days are dropped. Empty → 7
SPOOL_MAX_AGE_DAYS=
# Codex rollout log dir. Empty → ~/.codex/sessions
CODEX_SESSIONS_DIR=
# First sight of a Codex log whose file MTIME is older than this → only its session is learned, then
# it is tailed from EOF. Empty → 2. 0 → every first-seen log is tailed from EOF.
CODEX_BACKFILL_HOURS=
# 1 → on first sight also skip records whose own timestamp is older than CODEX_BACKFILL_HOURS
# (an old session resumed today). Empty → off (mtime rule only)
CODEX_BACKFILL_EVENT_FILTER=

# ── hook launcher (apps/collector/bin/claude-hook) ───────────────────────────
# Read by the shell launcher from the environment Claude Code runs hooks with — NOT from this
# file (.env is not read for these two). Set them in the hook command if you need to.
# Seconds before the launcher SIGKILLs a stuck hook. Empty → 0.6
AGENTCITY_HOOK_KILL_S=
# Bun binary for the hook. Empty → `command -v bun`, else ~/.bun/bin/bun
AGENTCITY_BUN=
